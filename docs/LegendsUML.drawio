<mxfile host="app.diagrams.net"><diagram id="legends-uml" name="Legends UML"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3020" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="Main" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;Main&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:5px;"&gt;+ main(args: String[])&lt;br/&gt;- runSelector(config, seed, color, input)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="58" y="73" width="256" height="70" as="geometry"/></mxCell><mxCell id="GameController" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;abstract&amp;raquo;&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GameController&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:5px;"&gt;- input: Scanner&lt;br/&gt;- config: GameConfig&lt;br/&gt;- seed: long&lt;br/&gt;- colorEnabled: boolean&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:5px;"&gt;+ run() {abstract}&lt;br/&gt;# choose(prompt, options): T&lt;br/&gt;# chooseHero(prompt, heroes): HeroTto&lt;br/&gt;# readLine(prompt): String&lt;br/&gt;# readNumber(prompt, min, max): int&lt;br/&gt;# colored(message, color): String&lt;br/&gt;# printError / printSuccess / printInfo(message)&lt;br/&gt;# handleCommand(value): boolean&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="415" y="62" width="352" height="244" as="geometry"/></mxCell><mxCell id="ConfigLoader" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;ConfigLoader&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:5px;"&gt;+ load(directory: Path): GameConfig&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="872" y="76" width="240" height="55" as="geometry"/></mxCell><mxCell id="GameConfig" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;b&gt;GameConfig&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:5px;"&gt;- heroTtos: List&amp;lt;HeroTto&amp;gt;&lt;br/&gt;- monsterTtos: List&amp;lt;MonsterTto&amp;gt;&lt;br/&gt;- weapons, armor, potions, spells&lt;br/&gt;- skills: List&amp;lt;Skill&amp;gt;&lt;br/&gt;- equipmentRuleTtos&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:5px;"&gt;+ getHeroTtos(): List&amp;lt;HeroTto&amp;gt;&lt;br/&gt;+ getMonsterTtos(): List&amp;lt;MonsterTto&amp;gt;&lt;br/&gt;+ getWeapons() / getArmor() / ...&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1206" y="57" width="300" height="170" as="geometry"/></mxCell><mxCell id="RandomWeights" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;utility&amp;raquo;&lt;/i&gt;&lt;br/&gt;&lt;b&gt;RandomWeights&lt;/b&gt;&lt;/p&gt;&lt;hr size="1"/&gt;&lt;p style="margin:0px;margin-left:5px;"&gt;+ pick(random, weights: int[]): int {static}&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1589" y="196" width="240" height="69" as="geometry"/></mxCell><mxCell id="TileType" value='&lt;p style="margin:0px;margin-top:4px;text-align:center;"&gt;&lt;i&gt;&amp;laquo;enumerati